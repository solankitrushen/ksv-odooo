// Accessing environment variables
const apiPort = import.meta.env.VITE_BACKEND_DEV_PORT;
const isAnalyticsEnabled = import.meta.env.VITE_ENABLE_ANALYTICS === 'true';
const appName = import.meta.env.VITE_APP_NAME;

