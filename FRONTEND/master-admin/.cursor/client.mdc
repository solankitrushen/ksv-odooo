## 🎨 UI Component Patterns

### Component Hierarchy

```
1. Shadcn/UI Primitives (/ui/components/ui/)
   ↓ Building blocks (Button, Input, Card, etc.)
   
2. Shared Custom Components (/ui/components/shared/)
   ↓ Reusable business components
   
3. Layout Components (/ui/containers/layout/)
   ↓ AppLayout, Sidebar, TopBar
   
4. Domain Containers (/ui/containers/osmo/)
   ↓ PageHeader, StatCard, DataTable, etc.
   
5. Pages (/ui/pages/)
   ↓ Feature pages combining all above
```

### Page Component Template

```jsx
// src/ui/pages/NewFeature/NewFeature.jsx
import { useState, useEffect } from 'react';
import { AppLayout } from '../../containers/layout/AppLayout';
import { PageHeader } from '../../containers/osmo/PageHeader';
import { Button } from '../../components/ui/button';
import { Card, CardHeader, CardTitle, CardContent } from '../../components/ui/card';
import { Skeleton } from '../../components/ui/skeleton';
import { Alert, AlertDescription } from '../../components/ui/alert';
import { newFeatureApi } from '../../../services/api/newFeature.api';
import { useToast } from '../../../services/hooks/useToast';

export default function NewFeature() {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const { toast } = useToast();
  
  useEffect(() => {
    loadData();
  }, []);
  
  const loadData = async () => {
    try {
      setLoading(true);
      const result = await newFeatureApi.getData();
      setData(result);
      setError(null);
    } catch (err) {
      setError(err.message);
      toast({
        title: "Error",
        description: "Failed to load data",
        variant: "destructive",
      });
    } finally {
      setLoading(false);
    }
  };
  
  const handleAction = async () => {
    try {
      await newFeatureApi.performAction();
      toast({
        title: "Success",
        description: "Action completed successfully",
      });
      loadData(); // Refresh data
    } catch (err) {
      toast({
        title: "Error",
        description: "Action failed",
        variant: "destructive",
      });
    }
  };
  
  // Loading state
  if (loading) {
    return (
      <AppLayout>
        <PageHeader title="New Feature" description="Loading..." />
        <div className="space-y-4">
          <Skeleton className="h-32" />
          <Skeleton className="h-64" />
        </div>
      </AppLayout>
    );
  }
  
  // Error state
  if (error) {
    return (
      <AppLayout>
        <PageHeader title="New Feature" description="Error loading data" />
        <Alert variant="destructive">
          <AlertDescription>{error}</AlertDescription>
        </Alert>
        <Button onClick={loadData} className="mt-4">Retry</Button>
      </AppLayout>
    );
  }
  
  // Empty state
  if (!data || data.length === 0) {
    return (
      <AppLayout>
        <PageHeader title="New Feature" description="No data available" />
        <div className="flex flex-col items-center justify-center py-12">
          <p className="text-muted-foreground">No data to display</p>
          <Button onClick={loadData} className="mt-4">Refresh</Button>
        </div>
      </AppLayout>
    );
  }
  
  // Success state
  return (
    <AppLayout>
      <PageHeader 
        title="New Feature" 
        description="Description of the feature"
        action={
          <Button onClick={handleAction}>
            Take Action
          </Button>
        }
      />
      
      <div className="space-y-6">
        <div className="grid gap-4 md:grid-cols-3">
          <Card>
            <CardHeader>
              <CardTitle>Metric 1</CardTitle>
            </CardHeader>
            <CardContent>
              <p className="text-2xl font-bold">{data.metric1}</p>
            </CardContent>
          </Card>
          
          <Card>
            <CardHeader>
              <CardTitle>Metric 2</CardTitle>
            </CardHeader>
            <CardContent>
              <p className="text-2xl font-bold">{data.metric2}</p>
            </CardContent>
          </Card>
          
          <Card>
            <CardHeader>
              <CardTitle>Metric 3</CardTitle>
            </CardHeader>
            <CardContent>
              <p className="text-2xl font-bold">{data.metric3}</p>
            </CardContent>
          </Card>
        </div>
        
        <Card>
          <CardHeader>
            <CardTitle>Details</CardTitle>
          </CardHeader>
          <CardContent>
            {/* Main content */}
          </CardContent>
        </Card>
      </div>
    </AppLayout>
  );
}
```

