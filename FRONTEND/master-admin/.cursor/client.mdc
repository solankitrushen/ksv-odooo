### Context State Pattern (Shared UI)

```jsx
// src/services/context/SidebarContext.jsx
import { createContext, useState, useContext } from 'react';

const SidebarContext = createContext();

export function SidebarProvider({ children }) {
  const [isOpen, setIsOpen] = useState(true);
  const [isPinned, setIsPinned] = useState(false);
  
  const toggle = () => setIsOpen(!isOpen);
  const pin = () => setIsPinned(!isPinned);
  
  return (
    <SidebarContext.Provider value={{ isOpen, isPinned, toggle, pin }}>
      {children}
    </SidebarContext.Provider>
  );
}

export const useSidebar = () => {
  const context = useContext(SidebarContext);
  if (!context) {
    throw new Error('useSidebar must be used within SidebarProvider');
  }
  return context;
};
```

### Server State Pattern (React Query)

```jsx
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { analyticsApi } from '../services/api/analytics.api';
import { useToast } from '../services/hooks/useToast';

function AnalyticsPage() {
  const queryClient = useQueryClient();
  const { toast } = useToast();
  
  // Fetch data with caching
  const { data, isLoading, error, refetch } = useQuery({
    queryKey: ['analytics', 'metrics', { period: '30d' }],
    queryFn: () => analyticsApi.getMetrics({ period: '30d' }),
    staleTime: 5 * 60 * 1000, // 5 minutes
    cacheTime: 10 * 60 * 1000, // 10 minutes
  });
  
  // Create mutation
  const createReport = useMutation({
    mutationFn: analyticsApi.createReport,
    onSuccess: (data) => {
      // Invalidate and refetch
      queryClient.invalidateQueries(['analytics', 'reports']);
      toast({
        title: "Success",
        description: "Report created successfully",
      });
    },
    onError: (error) => {
      toast({
        title: "Error",
        description: error.response?.data?.message || "Failed to create report",
        variant: "destructive",
      });
    },
  });
  
  const handleCreateReport = (reportData) => {
    createReport.mutate(reportData);
  };
  
  if (isLoading) return <Spinner />;
  if (error) return <Alert>Error: {error.message}</Alert>;
  
  return (
    <div>
      <MetricsDisplay data={data} />
      <Button 
        onClick={() => handleCreateReport({ name: 'New Report' })}
        disabled={createReport.isLoading}
      >
        {createReport.isLoading ? 'Creating...' : 'Create Report'}
      </Button>
    </div>
  );
}
```

### State Management Rules

1. ✅ **Use local state by default** - lift only when needed
2. ✅ **Use context for shared UI state** (theme, sidebar, modals)
3. ✅ **Use React Query for API data** - automatic caching & refetching
4. ✅ **Invalidate queries** after mutations to refresh data
5. ✅ **Avoid prop drilling** - use context or composition
6. ✅ **Keep query keys consistent** - use arrays with parameters
7. ✅ **Set appropriate staleTime** based on data freshness needs
8. ✅ **Handle loading and error states** for every query

