## 🌐 API Layer Standards

### Client Configuration

```javascript
// src/services/api/client.js
import axios from "axios";
import { setupInterceptors } from "./interceptors";

const ENV = import.meta.env.MODE;

const PORT_MAP = {
  development: import.meta.env.VITE_BACKEND_DEV_PORT || 5002,
  staging: import.meta.env.VITE_BACKEND_STAGING_PORT || 5002,
  production: import.meta.env.VITE_BACKEND_PROD_PORT || 5002,
};

const BASE_URL = `http://localhost:${PORT_MAP[ENV]}`;

export const apiClient = axios.create({
  baseURL: BASE_URL,
  timeout: 30000,
  headers: { "Content-Type": "application/json" },
  withCredentials: true, // CRITICAL: Enables cookies
});

setupInterceptors(apiClient);

export default apiClient;
```

### API Interceptors

```javascript
// src/services/api/interceptors.js
import { getCookie } from "../auth/cookies";

export const setupInterceptors = (client) => {
  // Request interceptor - attach auth token
  client.interceptors.request.use(
    (config) => {
      const token = getCookie("user_token") || getCookie("admin_token");
      if (token) {
        config.headers.Authorization = `Bearer ${token}`;
      }
      return config;
    },
    (error) => Promise.reject(error)
  );
  
  // Response interceptor - handle errors globally
  client.interceptors.response.use(
    (response) => response,
    (error) => {
      if (error.response?.status === 401) {
        // Token expired - redirect to login
        window.location.href = "/auth/login";
      }
      return Promise.reject(error);
    }
  );
};
```

### Creating API Modules

**Template for New API Module**

```javascript
// src/services/api/analytics.api.js
import { apiClient } from './client';

export const analyticsApi = {
  // GET request with params
  getMetrics: async (params) => {
    const response = await apiClient.get('/api/v1/analytics/metrics', { params });
    return response.data;
  },
  
  // GET request with path params
  getReportById: async (id) => {
    const response = await apiClient.get(`/api/v1/analytics/reports/${id}`);
    return response.data;
  },
  
  // POST request
  createReport: async (data) => {
    const response = await apiClient.post('/api/v1/analytics/reports', data);
    return response.data;
  },
  
  // PUT request
  updateReport: async (id, data) => {
    const response = await apiClient.put(`/api/v1/analytics/reports/${id}`, data);
    return response.data;
  },
  
  // PATCH request (partial update)
  patchReport: async (id, data) => {
    const response = await apiClient.patch(`/api/v1/analytics/reports/${id}`, data);
    return response.data;
  },
  
  // DELETE request
  deleteReport: async (id) => {
    const response = await apiClient.delete(`/api/v1/analytics/reports/${id}`);
    return response.data;
  },
  
  // File upload
  uploadData: async (file) => {
    const formData = new FormData();
    formData.append('file', file);
    
    const response = await apiClient.post('/api/v1/analytics/upload', formData, {
      headers: { 'Content-Type': 'multipart/form-data' },
    });
    return response.data;
  },
};
```

### Using API in Components

```jsx
import { useState, useEffect } from 'react';
import { analyticsApi } from '../../services/api/analytics.api';
import { useToast } from '../../services/hooks/useToast';

function AnalyticsPage() {
  const [metrics, setMetrics] = useState(null);
  const [loading, setLoading] = useState(true);
  const { toast } = useToast();
  
  useEffect(() => {
    fetchMetrics();
  }, []);
  
  const fetchMetrics = async () => {
    try {
      const data = await analyticsApi.getMetrics({ period: '30d' });
      setMetrics(data);
    } catch (error) {
      toast({
        title: "Error",
        description: error.response?.data?.message || "Failed to load metrics",
        variant: "destructive",
      });
      console.error('Failed to fetch metrics:', error);
    } finally {
      setLoading(false);
    }
  };
  
  const handleCreateReport = async (reportData) => {
    try {
      await analyticsApi.createReport(reportData);
      toast({
        title: "Success",
        description: "Report created successfully",
      });
      fetchMetrics(); // Refresh data
    } catch (error) {
      toast({
        title: "Error",
        description: "Failed to create report",
        variant: "destructive",
      });
    }
  };
  
  if (loading) return <Spinner />;
  
  return (
    <div>
      {/* Render metrics */}
    </div>
  );
}
```

### API Rules

1. ✅ **Always use apiClient** - don't create new axios instances
2. ✅ **Group related endpoints** in the same API module
3. ✅ **Return response.data** from API functions
4. ✅ **Use async/await** - no .then() chains
5. ✅ **Handle errors** in components with try/catch
6. ✅ **Show user feedback** with toast notifications
7. ✅ **Never hardcode API URLs** - use environment variables
8. ✅ **Use FormData** for file uploads
9. ✅ **Add request timeouts** for long-running operations
10. ✅ **Cancel requests** on component unmount if needed

