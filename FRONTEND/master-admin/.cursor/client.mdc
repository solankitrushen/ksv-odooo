## ⚠️ Error Handling

### Comprehensive Error Handling Pattern

```jsx
import { useState } from 'react';
import { useToast } from '../../services/hooks/useToast';
import { useNavigate } from 'react-router';
import { userApi } from '../../services/api/user.api';

function UserProfile() {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const { toast } = useToast();
  const navigate = useNavigate();
  
  const updateProfile = async (data) => {
    setLoading(true);
    setError(null);
    
    try {
      const result = await userApi.updateProfile(data);
      
      toast({
        title: "Success",
        description: "Profile updated successfully",
      });
      
      return result;
      
    } catch (err) {
      let errorMessage = "Something went wrong. Please try again.";
      
      // Handle specific HTTP status codes
      if (err.response) {
        const { status, data } = err.response;
        
        switch (status) {
          case 400:
            errorMessage = data.message || "Invalid request";
            break;
          case 401:
            errorMessage = "Please log in again";
            navigate('/auth/login');
            break;
          case 403:
            errorMessage = "You don't have permission to do this";
            break;
          case 404:
            errorMessage = "Resource not found";
            break;
          case 422:
            errorMessage = data.message || "Validation error";
            // Handle field-specific errors
            if (data.errors) {
              // Set form field errors
              Object.keys(data.errors).forEach(field => {
                console.error(`${field}: ${data.errors[field]}`);
              });
            }
            break;
          case 500:
            errorMessage = "Server error. Please try again later";
            break;
          default:
            errorMessage = data.message || errorMessage;
        }
      } else if (err.request) {
        // Network error
        errorMessage = "Network error. Please check your connection";
      }
      
      setError(errorMessage);
      
      toast({
        title: "Error",
        description: errorMessage,
        variant: "destructive",
      });
      
      // Log for debugging
      console.error('Profile update failed:', {
        error: err,
        message: errorMessage,
        response: err.response,
      });
      
      throw err; // Re-throw if caller needs to handle
      
    } finally {
      setLoading(false);
    }
  };
  
  return (
    <form onSubmit={async (e) => {
      e.preventDefault();
      try {
        await updateProfile(formData);
        // Success handling
      } catch (err) {
        // Already handled in updateProfile
      }
    }}>
      {error && (
        <Alert variant="destructive" className="mb-4">
          <AlertDescription>{error}</AlertDescription>
        </Alert>
      )}
      {/* Form fields */}
      <Button type="submit" disabled={loading}>
        {loading ? 'Saving...' : 'Save Profile'}
      </Button>
    </form>
  );
}
```

### Error Boundary Component

```jsx
// src/ui/components/shared/ErrorBoundary.jsx
import React from 'react';
import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
import { Button } from '@/components/ui/button';
import { AlertCircle } from 'lucide-react';

class ErrorBoundary extends React.Component {
  constructor(props) {
    super(props);
    this.state = { hasError: false, error: null };
  }
  
  static getDerivedStateFromError(error) {
    return { hasError: true, error };
  }
  
  componentDidCatch(error, errorInfo) {
    console.error('Error caught by boundary:', error, errorInfo);
    // Send to error reporting service
  }
  
  handleReset = () => {
    this.setState({ hasError: false, error: null });
    window.location.reload();
  };
  
  render() {
    if (this.state.hasError) {
      return (
        <div className="flex min-h-screen items-center justify-center p-4">
          <Alert variant="destructive" className="max-w-lg">
            <AlertCircle className="h-4 w-4" />
            <AlertTitle>Something went wrong</AlertTitle>
            <AlertDescription className="mt-2">
              {this.state.error?.message || 'An unexpected error occurred'}
            </AlertDescription>
            <Button 
              onClick={this.handleReset}
              variant="outline"
              className="mt-4"
            >
              Reload Page
            </Button>
          </Alert>
        </div>
      );
    }
    
    return this.props.children;
  }
}

export default ErrorBoundary;
```

### Error Handling Rules

1. ✅ **Always use try/catch** for async operations
2. ✅ **Show user-friendly messages** in toast notifications
3. ✅ **Log errors to console** for debugging (include context)
4. ✅ **Handle specific status codes** (400, 401, 403, 404, 422, 500)
5. ✅ **Use finally block** to reset loading states
6. ✅ **Don't expose technical details** to users
7. ✅ **Provide retry options** for failed operations
8. ✅ **Use Error Boundaries** for component tree errors
9. ✅ **Send errors to monitoring service** in production
10. ✅ **Handle network errors** separately from API errors

